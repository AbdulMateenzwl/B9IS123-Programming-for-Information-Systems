{
  "name": "deloitteedge-expense-api",
  "version": "1.0.0",
  "description": "DeloitteEdge Consulting – Corporate Expense & Approval System",
  "author": "DeloitteEdge",
  "private": true,
  "license": "UNLICENSED",
  "scripts": {
